{
  "name": "ruleta",
  "productName": "Ruleta",
  "version": "1.0.0",
  "description": "Ruleta para sortear opciones, funciona sin internet",
  "author": "Matias",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.matubil.ruleta",
    "productName": "Ruleta",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Ruleta.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
